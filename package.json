{
  "name": "mori-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "tsx packages/mori/src/index.ts",
    "bench:pr-smoke": "tsx packages/mori/src/bench/preference-regression/pr-smoke.ts",
    "bench:pr-smoke:record": "tsx packages/mori/src/bench/preference-regression/pr-smoke.ts --record",
    "bench:nightly-slice": "tsx packages/mori/src/bench/preference-regression/nightly-slice-cli.ts",
    "bench:milestone": "tsx packages/mori/src/bench/preference-regression/milestone-cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:ci-scripts": "for t in .github/scripts/*.test.sh; do bash \"$t\" || exit 1; done",
    "typecheck:test": "turbo run typecheck:test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "turbo": "2.10.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
